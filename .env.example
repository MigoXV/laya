LAYA_MODEL_DIR=/workspace/model-bin/MigoXV/laya-multilingual
LAYA_DEVICE=cuda:0
LAYA_DTYPE=fp16
LAYA_RUNNER=eager
LAYA_MAX_BATCH_SIZE=1
LAYA_MAX_BATCH_TOKENS=8192
LAYA_BATCH_WAIT_MS=2
LAYA_GRAPH_STREAMS=8
LAYA_GRAPH_CACHE_SIZE=16
# [批次容量, 精确序列长度, 选项数]；服务就绪前捕获，数量不能超过 Graph 缓存。
LAYA_GRAPH_PREWARM_PROFILES=[]
LAYA_COMPILE_CACHE_SIZE=32
# 小批文本默认关闭 Rust 线程池；可显式覆盖。
TOKENIZERS_PARALLELISM=false
LAYA_HOST=0.0.0.0
LAYA_PORT=10002
LAYA_QUEUE_SIZE=32
LAYA_REQUEST_TIMEOUT=30
LAYA_SHUTDOWN_TIMEOUT=5
LAYA_DEMO_SERVICE_URL=http://127.0.0.1:10002
LAYA_DEMO_TIMEOUT=60
LAYA_DEMO_HOST=0.0.0.0
LAYA_DEMO_PORT=10013
