{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Laya 服务",
      "type": "debugpy",
      "request": "launch",
      "module": "laya.commands.app",
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "serve",
        "--model-dir",
        "${input:layaModelDir}"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Laya Demo 01",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.demo01.commands.app",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "demo01: build",
      "args": [
        "serve"
      ],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "layaModelDir",
      "type": "promptString",
      "description": "显式输入 FP16 或 W8A8 模型仓库目录"
    }
  ]
}
